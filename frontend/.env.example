REACT_APP_CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key

# Backend base origin only. Do not add /api.
REACT_APP_API_BASE_URL=http://localhost:5001

# Set to "true" once a live payroll provider is actually connected. Until
# then, the Payroll page shows a "Coming Soon" state instead of the
# (fully built, sandbox-tested) payroll run UI.
REACT_APP_PAYROLL_LIVE=false

# Your Gusto partner referral link (sign up at gusto.com/partners). Falls
# back to the generic partners page if unset.
REACT_APP_GUSTO_REFERRAL_URL=https://gusto.com/partners